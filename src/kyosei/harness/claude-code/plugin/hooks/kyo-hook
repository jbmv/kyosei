#!/bin/sh
# Generated by `python -m kyosei.harness` from kyosei.install_hooks.PATH_GUARD_PREFIX
# (KYO-605). The PATH guard the packaged hook fragments carry inline: with `kyo`
# missing, silent exit 0 outside a Kyosei project (KYO-591) and one line with
# exit 127 inside one (KYO-316). Otherwise it runs `kyo` with this script's
# arguments and keeps its exit status.
command -v kyo >/dev/null 2>&1 || { d="${CLAUDE_PROJECT_DIR:-$PWD}"; c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; { [ -n "$c" ] && { [ -e "${c%/*}/kyosei/config.yml" ] || [ -e "${c%/*}/.kyosei" ]; }; } || while [ ! -e "$d/kyosei/config.yml" ] && [ ! -e "$d/.kyosei" ]; do case "$d" in */*) d="${d%/*}" ;; *) exit 0 ;; esac; done; echo 'Kyosei CLI (kyo) is not on PATH, so this hook did not run. Install it: uv tool install kyosei (or pipx install kyosei), then start a new session' >&2; exit 127; }; exec kyo "$@"
