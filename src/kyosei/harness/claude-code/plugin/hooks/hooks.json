{
  "description": "Kyosei's session hooks: the session-start brief, the stop-time sweep and doctor, the dispatched worker's clean-tree and branch checks, and the push and command guards. Generated from the packaged hook fragments; every command exits 0 silently outside a Kyosei project.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" brief --compact --session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" sessions --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" sweep --hook && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" doctor --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" sessions --hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" sweep --hook && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" doctor --hook",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" sessions --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" check-clean --subagent-stop"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" check-branch --subagent-stop --against main"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" check-push --pre-tool-use"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" check-command --pre-tool-use"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kyo-hook\" check-build --hook"
          }
        ]
      }
    ]
  }
}
