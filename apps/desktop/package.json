{
  "name": "@kyosei/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Kyosei desktop app: the window shell and its live seams (KYO-110, KYO-111).",
  "license": "Apache-2.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "pack": "node build.mjs --pack",
    "tabs": "node build.mjs --tabs",
    "pretypecheck": "node build.mjs --tabs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests build.mjs",
    "format": "biome check --write src tests build.mjs",
    "smoke": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run smoke",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "electron": "^44.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
